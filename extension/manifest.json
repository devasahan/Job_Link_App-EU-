{
  "manifest_version": 3,
  "name": "JobBridge EU",
  "version": "2.4.0",
  "description": "Fetch remote developer jobs open to people in the EU from Indeed, Himalayas, Jobicy, Hacker News and more, then download Excel.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobBridge EU",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://apis.indeed.com/*",
    "https://himalayas.app/*",
    "https://jobicy.com/*",
    "https://hn.algolia.com/*",
    "https://euremotejobs.com/*",
    "https://arc.dev/*",
    "https://boards-api.greenhouse.io/*",
    "https://boards-api.eu.greenhouse.io/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "header_rules",
        "enabled": true,
        "path": "rules/headers.json"
      }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
